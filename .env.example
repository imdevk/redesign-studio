# Copy this file to .env and fill in the two required lines. Never share .env.

# --- Required ---
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# The model name exactly as shown in your OpenAI account. Pick one that is good at long HTML and accepts images.
OPENAI_MODEL=

# --- Optional ---
# Send a screenshot of the original page to the AI so it can see the layout and colours.
# Set to false if your model does not accept images.
USE_SCREENSHOT=true
# Longest answer the AI may write, in tokens. Raise it if designs get cut off.
MAX_OUTPUT_TOKENS=16000
# Port for the local server.
PORT=3100
# By default, addresses on private networks and localhost are refused. Set to true to redesign a site running on your own machine.
ALLOW_PRIVATE_URLS=false
# Use your installed Chrome or Chromium instead of the one from "npm run setup". Example (Windows):
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
# Where saved designs are kept.
DATA_DIR=./data
